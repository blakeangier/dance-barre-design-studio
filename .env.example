# Copy this file to .env.local and fill in the DEV project values.
# Do not commit .env.local. Do not point these at a production project.

# Public. These are baked into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older dashboard name for the same public key. Used only if the publishable key above is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is opened. Used to build email sign-in links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix these with NEXT_PUBLIC_.
# Use the new secret key if you have one, otherwise the legacy service_role key.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Server only. Low-fabric digest via Resend. Leave blank in tests and CI.
# Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=

# Vercel Cron sends Authorization: Bearer <this value> to /api/low-stock-digest.
# Set the same value on the Vercel project. Never prefix it with NEXT_PUBLIC_.
CRON_SECRET=

# Web Push. Server only. Never prefix these with NEXT_PUBLIC_ and never commit the keys.
# Generate a pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact, such as mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
